# Variables de entorno para la app Flutter
# Se pasan via --dart-define al compilar/correr:
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://localhost:3000/api/v1
#
# O en Android Studio / VS Code, configurar en launch.json:
#   "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:3000/api/v1"]
#
# Para emulador Android usar 10.0.2.2 en vez de localhost:
#   --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1

API_BASE_URL=http://localhost:3000/api/v1
